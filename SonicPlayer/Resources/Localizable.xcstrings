          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте скорость воспроизведения, длительность перемотки, тему и язык. Повторяйте этот быстрый старт в любое время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整播放速度、跳过时长、主题和语言。随时重播此快速入门。"
          }
        }
      }
    },
    "Turn past the last row.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدر إلى ما بعد آخر صف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষ সারির ওপারে ঘোরান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn past the last row."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira más allá de la última fila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez au-delà de la dernière ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतिम पंक्ति के आगे घुमाएँ।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rode para lá da última linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутите за последнюю строку."
