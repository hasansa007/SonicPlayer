    "Your own audio, no ads and no algorithms": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوتك أنت، بلا إعلانات ولا خوارزميات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নিজের অডিও, বিজ্ঞাপন ও অ্যালগরিদম ছাড়া"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own audio, no ads and no algorithms"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu propio audio, sin anuncios ni algoritmos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre propre audio, sans publicité ni algorithme"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका अपना ऑडियो, न विज्ञापन न एल्गोरिद्म"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu próprio áudio, sem anúncios nem algoritmos"
          }
        },
        "ru": {
          "stringUnit": {
