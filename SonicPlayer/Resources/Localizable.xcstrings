            "value" : "اضبط سرعة التشغيل ومدة التخطي والسمة واللغة. أعد هذا الدليل السريع في أي وقت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্লেব্যাক গতি, স্কিপ সময়, থিম এবং ভাষা ঠিক করুন। এই কুইকস্টার্ট যেকোনো সময় আবার চালান।"
          }
        },
        "en" : {
          "stringUnit" : {
