    "There is no analytics, no account and no network request. The microphone is used only while you are recording, which is the one permission the app asks for.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحليلات ولا حساب ولا أي طلب شبكة. ولا يُستخدم الميكروفون إلا أثناء التسجيل، وهو الإذن الوحيد الذي يطلبه التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অ্যানালিটিক্স নেই, অ্যাকাউন্ট নেই, নেটওয়ার্ক অনুরোধও নেই। মাইক্রোফোন কেবল রেকর্ড করার সময়ই ব্যবহৃত হয় — অ্যাপটি এই একটিমাত্র অনুমতি চায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no analytics, no account and no network request. The microphone is used only while you are recording, which is the one permission the app asks for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay analíticas, ni cuenta, ni peticiones de red. El micrófono solo se usa mientras grabas, y es el único permiso que pide la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune analyse, aucun compte, aucune requête réseau. Le micro n'est utilisé que pendant l'enregistrement : c'est la seule autorisation demandée par l'app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न कोई एनालिटिक्स, न खाता, न कोई नेटवर्क अनुरोध। माइक्रोफ़ोन केवल रिकॉर्ड करते समय इस्तेमाल होता है, और ऐप यही एक अनुमति माँगता है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há analítica, nem conta, nem pedidos de rede. O microfone só é usado enquanto grava, e é a única permissão que a app pede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никакой аналитики, аккаунтов и сетевых запросов. Микрофон используется только во время записи — это единственное разрешение, которое запрашивает приложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有分析统计，没有账号，也没有任何网络请求。麦克风仅在录音时使用，这是应用唯一申请的权限。"
          }
        }
      }
    },
