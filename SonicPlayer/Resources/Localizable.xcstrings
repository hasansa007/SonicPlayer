        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le fichier. Il a peut-être été déplacé ou supprimé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल पढ़ी नहीं जा सकी। हो सकता है इसे हटाया या स्थानांतरित किया गया हो।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
