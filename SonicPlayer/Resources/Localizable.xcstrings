    "The ring shows the level as you record, and moves the handles when you cut.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُظهر الحلقة مستوى الصوت أثناء التسجيل، وتحرّك المقابض عند القص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডের সময় রিং মাত্রা দেখায়, আর কাটার সময় হ্যান্ডেল সরায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ring shows the level as you record, and moves the handles when you cut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El anillo muestra el nivel mientras grabas y mueve los marcadores cuando recortas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'anneau affiche le niveau pendant l'enregistrement et déplace les poignées lors du rognage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड करते समय रिंग स्तर दिखाती है, और काटते समय हैंडल चलाती है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O anel mostra o nível enquanto grava e move os marcadores quando corta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кольцо показывает уровень при записи и двигает маркеры при обрезке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音时圆环显示电平，裁剪时它移动手柄。"
          }
        }
      }
    },
