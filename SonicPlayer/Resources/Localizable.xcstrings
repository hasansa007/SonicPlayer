    "Tune playback speed, skip duration, and appearance. Replay this quickstart any time." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط سرعة التشغيل ومدة التخطي والمظهر. أعد هذا الدليل السريع في أي وقت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্লেব্যাক গতি, স্কিপ সময় এবং থিম ঠিক করুন। এই কুইকস্টার্ট যেকোনো সময় আবার চালান।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tune playback speed, skip duration, and appearance. Replay this quickstart any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la velocidad de reproducción, la duración del salto y la apariencia. Repite este inicio rápido en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez la vitesse de lecture, la durée de saut et l’apparence. Relancez ce guide à tout moment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लेबैक गति, स्किप अवधि और रूप-रंग को समायोजित करें। इस क्विकस्टार्ट को कभी भी दोबारा चलाएँ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste a velocidade de reprodução, a duração do salto e a aparência. Refaça este guia rápido a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте скорость воспроизведения, длительность перемотки и оформление. Повторяйте этот быстрый старт в любое время."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整播放速度、跳过时长和外观。随时重播此快速入门。"
          }
        }
      }
    },
    "Tune playback speed, skip duration, theme, and language. Replay this quickstart any time." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
