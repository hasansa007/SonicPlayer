    "Up to edit, down to delete, left to file, right to share. Rest your thumb and each one says its name.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأعلى للتحرير، لأسفل للحذف، لليسار للترتيب، ولليمين للمشاركة. أرِح إبهامك وسيذكر كلٌّ منها اسمه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উপরে সম্পাদনা, নিচে মুছে ফেলা, বামে ফাইল করা, ডানে শেয়ার। বুড়ো আঙুল রাখলেই প্রত্যেকটি নিজের নাম বলে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to edit, down to delete, left to file, right to share. Rest your thumb and each one says its name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba para editar, abajo para eliminar, izquierda para archivar, derecha para compartir. Apoya el pulgar y cada una dice su nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers le haut pour modifier, le bas pour supprimer, la gauche pour classer, la droite pour partager. Posez le pouce et chacune annonce son nom."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर संपादन, नीचे हटाना, बाएँ फ़ाइल करना, दाएँ साझा करना। अंगूठा टिकाएँ और हर एक अपना नाम बताएगा।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cima editar, para baixo eliminar, para a esquerda arquivar, para a direita partilhar. Pouse o polegar e cada uma diz o seu nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вверх — правка, вниз — удаление, влево — в папку, вправо — поделиться. Задержите палец, и каждое действие себя назовёт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上推编辑，下推删除，左推归档，右推分享。手指停住，每个动作都会报出名字。"
          }
        }
      }
    },
    "Use the Recordings tab to capture audio. Start, pause, and stop, then trim takes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم تبويب التسجيلات لالتقاط الصوت. ابدأ وأوقف مؤقتًا وأوقف، ثم قص المقاطع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অডিও ধারণের জন্য রেকর্ডিংস ট্যাব ব্যবহার করুন। শুরু করুন, বিরতি দিন, থামান, তারপর ট্রিম করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Recordings tab to capture audio. Start, pause, and stop, then trim takes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la pestaña Grabaciones para capturar audio. Inicia, pausa y detén, luego recorta las tomas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l’onglet Enregistrements pour capturer l’audio. Démarrez, mettez en pause et arrêtez, puis rognez les prises."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो कैप्चर करने के लिए रिकॉर्डिंग्स टैब का उपयोग करें। शुरू करें, पॉज़ करें और रोकें, फिर ट्रिम करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a aba Gravações para capturar áudio. Inicie, pause e pare, depois corte as tomadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте вкладку «Записи» для записи аудио. Запускайте, ставьте на паузу и останавливайте, затем обрезайте записи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“录音”标签来录制音频。开始、暂停、停止，然后修剪片段。"
          }
        }
      }
    },
