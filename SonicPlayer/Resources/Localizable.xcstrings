          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la velocidad de reproducción, la duración del salto, el tema y el idioma. Repite este inicio rápido en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez la vitesse de lecture, la durée de saut, le thème et la langue. Relancez ce guide à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लेबैक गति, स्किप अवधि, थीम और भाषा समायोजित करें। इस क्विकस्टार्ट को कभी भी दोबारा चलाएँ।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
