    "Use the Recordings tab to capture audio. Start, pause, and stop, then trim takes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم تبويب التسجيلات لالتقاط الصوت. ابدأ وأوقف مؤقتًا وأوقف، ثم قص المقاطع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অডিও ধারণের জন্য রেকর্ডিংস ট্যাব ব্যবহার করুন। শুরু করুন, বিরতি দিন, থামান, তারপর ট্রিম করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the Recordings tab to capture audio. Start, pause, and stop, then trim takes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la pestaña Grabaciones para capturar audio. Inicia, pausa y detén, luego recorta las tomas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez l’onglet Enregistrements pour capturer l’audio. Démarrez, mettez en pause et arrêtez, puis rognez les prises."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑडियो कैप्चर करने के लिए रिकॉर्डिंग्स टैब का उपयोग करें। शुरू करें, पॉज़ करें और रोकें, फिर ट्रिम करें।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a aba Gravações para capturar áudio. Inicie, pause e pare, depois corte as tomadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте вкладку «Записи» для записи аудио. Запускайте, ставьте на паузу и останавливайте, затем обрезайте записи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“录音”标签来录制音频。开始、暂停、停止，然后修剪片段。"
          }
        }
      }
    },
