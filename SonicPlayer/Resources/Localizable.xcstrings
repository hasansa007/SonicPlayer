    "Jump to Library or Recordings and tap any item to start playback instantly." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقل إلى المكتبة أو التسجيلات واضغط على أي عنصر لبدء التشغيل فورًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লাইব্রেরি বা রেকর্ডিংসে যান এবং সঙ্গে সঙ্গে প্লে করতে যেকোনো আইটেমে ট্যাপ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jump to Library or Recordings and tap any item to start playback instantly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve a Biblioteca o Grabaciones y toca cualquier elemento para empezar a reproducir al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accédez à Bibliothèque ou Enregistrements et touchez un élément pour lancer la lecture instantanément."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइब्रेरी या रिकॉर्डिंग्स पर जाएँ और तुरंत प्लेबैक शुरू करने के लिए किसी भी आइटम पर टैप करें।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
