    "We're here to help! Reach out through any of these channels:": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحن هنا للمساعدة! تواصل معنا عبر أي من هذه القنوات:"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা সাহায্য করতে এখানে আছি! নিচের যেকোনো মাধ্যমে যোগাযোগ করুন:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We're here to help! Reach out through any of these channels:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos aquí para ayudar. Contáctanos por cualquiera de estos canales:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous sommes là pour vous aider ! Contactez-nous via l’un de ces canaux :"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम मदद के लिए यहाँ हैं! इन माध्यमों से संपर्क करें:"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos aqui para ajudar! Fale conosco por qualquer um destes canais:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы всегда готовы помочь! Свяжитесь с нами любым из этих способов:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们随时为您提供帮助！可通过以下方式联系我们："
          }
        }
      }
    },
    "What it is for": {
      "localizations": {
