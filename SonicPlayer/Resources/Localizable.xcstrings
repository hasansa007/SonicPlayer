    "The file could not be read. It may have been moved or deleted.": {
      "comment": "Error message displayed when a file can't be read.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة الملف. ربما نُقل أو حُذف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলটি পড়া যায়নি। এটি সরানো বা মুছে ফেলা হয়ে থাকতে পারে।"
          }
        },
        "en": {
          "stringUnit": {
