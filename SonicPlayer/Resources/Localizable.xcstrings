    "Open Settings from the button under the card, rest on Playback speed and press to cycle through the speeds. It is used the next time a track opens.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح «الإعدادات» من الزر أسفل البطاقة، وقف على «سرعة التشغيل» واضغط للتنقّل بين السرعات. وتُطبَّق في المرة التالية التي يُفتح فيها مقطع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্ডের নিচের বোতাম থেকে সেটিংস খুলুন, প্লেব্যাক গতিতে থামুন এবং গতিগুলোর মধ্যে বদলাতে চাপ দিন। পরের বার কোনো ট্র্যাক খুললে এটি কার্যকর হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings from the button under the card, rest on Playback speed and press to cycle through the speeds. It is used the next time a track opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes desde el botón bajo la tarjeta, detente en Velocidad de reproducción y pulsa para pasar de una velocidad a otra. Se aplica la próxima vez que se abra una pista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Réglages depuis le bouton sous la carte, arrêtez-vous sur Vitesse de lecture et appuyez pour faire défiler les vitesses. Elle s'applique à la prochaine ouverture d'une piste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड के नीचे के बटन से सेटिंग्स खोलें, प्लेबैक गति पर रुकें और गति बदलने के लिए दबाएँ। यह अगली बार ट्रैक खुलने पर लागू होती है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra as Definições a partir do botão por baixo do cartão, pare em Velocidade de reprodução e prima para percorrer as velocidades. É aplicada da próxima vez que abrir uma faixa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Настройки» кнопкой под карточкой, остановитесь на «Скорость воспроизведения» и нажимайте, чтобы перебрать скорости. Она применится при следующем открытии трека."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用卡片下方的按钮打开设置，停在「播放速度」并按下即可循环切换速度。它会在下次打开音轨时生效。"
          }
        }
      }
    },
