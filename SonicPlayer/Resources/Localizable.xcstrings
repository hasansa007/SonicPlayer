          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己的音频，没有广告和算法"
          }
        }
      }
    },
    "Your recordings are stored on the device and never uploaded. The app needs no account and no connection, so it works the same on a plane as at home.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ تسجيلاتك على الجهاز ولا تُرفع أبداً. لا يحتاج التطبيق إلى حساب ولا اتصال، فيعمل في الطائرة كما يعمل في البيت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রেকর্ডিং ডিভাইসেই থাকে, কখনও আপলোড হয় না। অ্যাপটির কোনো অ্যাকাউন্ট বা সংযোগ লাগে না, তাই উড়োজাহাজে আর বাড়িতে একইভাবে চলে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recordings are stored on the device and never uploaded. The app needs no account and no connection, so it works the same on a plane as at home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus grabaciones se guardan en el dispositivo y nunca se suben. La app no necesita cuenta ni conexión, así que funciona igual en un avión que en casa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos enregistrements sont stockés sur l'appareil et ne sont jamais envoyés. L'app ne demande ni compte ni connexion : elle fonctionne pareil en avion et chez vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी रिकॉर्डिंग डिवाइस पर ही रहती हैं और कभी अपलोड नहीं होतीं। ऐप को न खाता चाहिए न कनेक्शन, इसलिए यह हवाई जहाज़ में भी वैसे ही चलता है जैसे घर पर।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas gravações ficam guardadas no dispositivo e nunca são carregadas. A app não precisa de conta nem de ligação, por isso funciona da mesma forma num avião e em casa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши записи хранятся на устройстве и никогда не выгружаются. Приложению не нужны ни аккаунт, ни соединение, поэтому в самолёте оно работает так же, как дома."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的录音保存在设备上，绝不会上传。应用不需要账号也不需要联网，在飞机上和在家里表现完全一样。"
          }
        }
      }
    },
